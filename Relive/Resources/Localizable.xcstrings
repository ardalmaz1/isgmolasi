    },
    "Your relationship, told through the photos you already have." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlişkiniz, zaten sahip olduğunuz fotoğraflarla anlatılıyor."
          }
        }
      }
    },
    "Your story" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hikâyeniz"
          }
        }
      }
    },
    "Your story has started." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hikâyeniz başladı."
          }
        }
      }
    },
    "Your story holds only the photos you chose or kept. Yuvi never identifies people. You can change access any time in Settings." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hikâyeniz yalnızca seçtiğiniz ya da sakladığınız fotoğrafları içerir. Yuvi kimseyi tanımlamaz. Erişimi Ayarlar'dan istediğiniz zaman değiştirebilirsiniz."
