    "Yuvi" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi"
          }
        }
      }
    },
    "Yuvi %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi %@"
          }
        }
      }
    },
    "Yuvi can only use photos you’ve shared with it. You can share more in Us → Photo Access, or choose others." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi yalnızca onunla paylaştığınız fotoğrafları kullanabilir. Biz → Fotoğraf Erişimi'nden daha fazlasını paylaşabilir ya da başkalarını seçebilirsiniz."
          }
        }
      }
    },
    "Yuvi can’t open that photo" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi o fotoğrafı açamıyor"
          }
