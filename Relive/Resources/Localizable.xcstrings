    },
    "This memory isn’t here anymore" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu anı artık burada değil"
          }
        }
      }
    },
    "This photo isn’t available right now." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu fotoğraf şu an kullanılamıyor."
          }
        }
      }
    },
    "This removes your story, notes and settings from Yuvi, and you’ll set it up again. Your books, collages, stories, movies, drafts and favorites stay, and so do memories you asked Yuvi not to suggest. Your photos in the Photos app are not touched." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem hikâyenizi, notlarınızı ve ayarlarınızı Yuvi'den siler, her şeyi yeniden kurarsınız. Kitaplarınız, kolajlarınız, hikâyeleriniz, filmleriniz, taslaklarınız ve favorileriniz kalır; Yuvi'nin önermemesini istediğiniz anılar da öyle. Fotoğraflar uygulamasındaki fotoğraflarınıza dokunulmaz."
          }
        }
      }
    },
    "This trend isn’t available" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu akım kullanılamıyor"
          }
        }
      }
    },
