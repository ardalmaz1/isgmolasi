            "value" : "Kullanım Koşulları"
          }
        }
      }
    },
    "Thank you. There’s more to find as your story grows." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teşekkürler. Hikâyeniz büyüdükçe bulunacak daha çok şey var."
