    },
    "Your first name (optional)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adınız (isteğe bağlı)"
          }
        }
      }
    },
    "Your memories, made into a book." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anılarınız, bir kitapta."
          }
        }
      }
    },
    "Your memories, moments, places, notes and favorites are always free. Premium is for what Yuvi creates from them." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anılarınız, anlarınız, yerleriniz, notlarınız ve favorileriniz her zaman ücretsiz. Premium, Yuvi'nin onlardan oluşturdukları için."
          }
        }
      }
    },
    "Your note" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notunuz"
