    },
    "Yuvi sees only the %@ you chose." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi yalnızca seçtiğiniz %@ görür."
          }
        }
      }
    },
    "Yuvi will choose the photos again. The photos and order you changed will be replaced; your style, shape, length and title stay." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi fotoğrafları yeniden seçecek. Değiştirdiğiniz fotoğraflar ve sıra yenilenecek; stiliniz, biçiminiz, uzunluğunuz ve başlığınız kalır."
          }
        }
      }
    },
    "Yuvi won’t count days together until you add a date in Us" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biz'den bir tarih ekleyene kadar Yuvi birlikte geçen günleri saymaz"
          }
        }
      }
    },
    "Yuvi works fully on your own. Connecting is optional and free." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi tek başınıza da tam çalışır. Bağlanmak isteğe bağlı ve ücretsiz."
          }
        }
      }
    },
    "Yuvi, for the two of you" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi, ikiniz için"
