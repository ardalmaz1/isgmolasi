        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partner bağlantınız"
          }
        }
      }
    },
    "Your partner doesn’t need Yuvi to see it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partnerinizin bunu görmek için Yuvi'ye ihtiyacı yok."
