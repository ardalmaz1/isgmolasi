            "value" : "En sevdiğiniz kişi"
          }
        }
      }
    },
    "Your first creation to save or share is free." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedeceğiniz ya da paylaşacağınız ilk üretim ücretsiz."
