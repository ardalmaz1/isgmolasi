    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Yuvi saves the collages and story cards you make to your photo library. They are made on this iPhone and never uploaded."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi, hazırladığınız kolajları ve hikâye kartlarını fotoğraf arşivinize kaydeder. Hepsi bu iPhone'da hazırlanır ve hiçbir yere yüklenmez."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Yuvi organizes the photos and videos you choose into a private timeline of your story. They are analyzed on this iPhone and never uploaded."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvi, seçtiğiniz fotoğraf ve videoları hikâyenizin gizli bir zaman çizgisine yerleştirir. Hepsi bu iPhone'da incelenir ve hiçbir yere yüklenmez."
          }
        }
      }
    }
  },
  "version" : "1.3"
}